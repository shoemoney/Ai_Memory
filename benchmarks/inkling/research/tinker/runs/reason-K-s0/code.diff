+def test_k_arm_gets_its_own_primary_verdict_and_token_bootstrap(tmp_path: Path):
+    write(tmp_path, "stock-cap2048", 358, 360, 500)
+    write(tmp_path, "R-final-cap1024", 330, 360, 450)
+    write(tmp_path, "K-final-cap1024", 345, 360, 200)
+    report = rr.summarise(tmp_path)
+    assert report["primary"]["K"]["passes_at_any_cap"] is True
+    assert report["primary"]["R"]["passes_at_any_cap"] is False
+    tokens = report["bootstrap"]["K minus R tokens @1024"]
+    assert tokens["difference"] == pytest.approx(-250) and tokens["high"] < 0
+    assert report["bootstrap"]["K minus R @1024"]["difference"] == pytest.approx(15 / 360)
