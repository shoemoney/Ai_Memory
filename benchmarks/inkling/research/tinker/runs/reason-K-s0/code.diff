+async def sample_extra(
+    rows: list[dict[str, Any]], out: Path, extra: int, max_tokens: int, parallel: int
+) -> None:
+    """Draw `extra` more samples per item (one request each, `num_samples=extra`)."""
+    import tinker
+
+    out.mkdir(parents=True, exist_ok=False)
+    renderer = make_renderer(MODEL_NAME)
+    service = tinker.ServiceClient(
+        display_name="distill-extra-" + out.name, user_metadata={"purpose": "shortest-of-k"}
+    )
+    ok = False
+    try:
+        client = await service.create_sampling_client(base_model=MODEL_NAME)
+        gate = asyncio.Semaphore(parallel)
+
+        async def one(row: dict[str, Any]) -> list[dict[str, Any]]:
+            async with gate:
+                prompt = renderer.build_generation_prompt(row["messages"], effort=EFFORT)
+                response = await client.sample_async(
+                    prompt=prompt,
+                    num_samples=extra,
+                    sampling_params=tinker.SamplingParams(
+                        max_tokens=max_tokens, temperature=1.0, stop=renderer.get_stop_sequences()
+                    ),
+                )
+            records = []
+            for n, sequence in enumerate(response.sequences, start=1):
+                message, termination = renderer.parse_response(sequence.tokens)
+                records.append(
+                    {
+                        "id": row["id"],
+                        "kind": row["kind"],
+                        "level": row["level"],
+                        "draw": n,
+                        "response": message,
+                        "termination": termination.value,
+                        "prompt_tokens": prompt.length,
+                        "sample_tokens": len(sequence.tokens),
+                        **verdict(row, message, termination.is_clean),
+                    }
+                )
+            return records
+
+        results = [r for group in await asyncio.gather(*(one(r) for r in rows)) for r in group]
+        results.sort(key=lambda r: (r["id"], r["draw"]))
+        (out / "samples.jsonl").write_text("".join(json.dumps(r) + "\n" for r in results))
+        usd = (
+            sum(r["prompt_tokens"] for r in results) / extra * 0.15
+            + sum(r["sample_tokens"] for r in results) * 0.50
+        ) / 1e6
+        report = {
+            "draws": len(results),
+            "sample_tokens": sum(r["sample_tokens"] for r in results),
+            "estimated_sampling_usd_prefill_once_per_request": usd,
+            "estimated_sampling_usd_prefill_per_draw": (
+                sum(r["prompt_tokens"] for r in results) * 0.15
+                + sum(r["sample_tokens"] for r in results) * 0.50
+            )
+            / 1e6,
+        }
+        (out / "sampling-report.json").write_text(json.dumps(report, indent=2) + "\n")
+        ok = True
+        print(json.dumps(report, indent=2))
+    finally:
+        await service.close("success" if ok else "errored")
+
