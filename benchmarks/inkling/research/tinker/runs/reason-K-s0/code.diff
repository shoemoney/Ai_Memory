+def paired_bootstrap_mean(
+    left: list[float], right: list[float], draws: int = 10_000, seed: int = 0
+) -> dict[str, float]:
+    """Paired bootstrap of the difference in means (for completion tokens)."""
+    rng = random.Random(seed)
+    n = len(left)
+    diffs = sorted(
+        sum(left[i] - right[i] for i in (rng.randrange(n) for _ in range(n))) / n
+        for _ in range(draws)
+    )
+    return {
+        "difference": sum(left) / n - sum(right) / n,
+        "low": diffs[int(0.025 * draws)],
+        "high": diffs[int(0.975 * draws) - 1],
+        "draws": draws,
+        "seed": seed,
+    }
+
