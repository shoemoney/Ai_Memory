+def select_shortest(
+    first: list[dict[str, Any]], extra: list[dict[str, Any]]
+) -> tuple[list[dict[str, Any]], dict[str, Any]]:
+    """Per item, keep the shortest verified sample out of the first draw and the extra ones."""
+    draws: dict[str, list[dict[str, Any]]] = {}
+    for record in first:
+        draws.setdefault(record["id"], []).append({**record, "draw": 0})
+    for record in extra:
+        draws.setdefault(record["id"], []).append(record)
+    chosen, per_item = [], []
+    for item_id in sorted(draws):
+        group = sorted(draws[item_id], key=lambda r: r["draw"])
+        good = [r for r in group if r["keep"]]
+        row = group[0]
+        info = {
+            "id": item_id,
+            "kind": row["kind"],
+            "level": row["level"],
+            "draws": len(group),
+            "n_correct": len(good),
+            "first_draw_correct": group[0]["keep"],
+        }
+        if good:
+            best = min(good, key=lambda r: (r["sample_tokens"], r["draw"]))
+            mean_correct = sum(r["sample_tokens"] for r in good) / len(good)
+            info.update(
+                kept_tokens=best["sample_tokens"],
+                mean_correct_tokens=mean_correct,
+                longest_correct_tokens=max(r["sample_tokens"] for r in good),
+                kept_draw=best["draw"],
+            )
+            chosen.append({**best, **info})
+        per_item.append(info)
+    by_kind: dict[str, dict[str, float]] = {}
+    for kind in hard.KINDS:
+        items = [i for i in per_item if i["kind"] == kind]
+        if not items:
+            continue
+        solved = [i for i in items if i["n_correct"]]
+        by_kind[kind] = {
+            "items": len(items),
+            "first_draw_keep_rate": sum(i["first_draw_correct"] for i in items) / len(items),
+            "at_least_one_correct_rate": len(solved) / len(items),
+            "mean_kept_tokens": (
+                sum(i["kept_tokens"] for i in solved) / len(solved) if solved else 0.0
+            ),
+            "mean_of_all_correct_tokens": (
+                sum(i["mean_correct_tokens"] for i in solved) / len(solved) if solved else 0.0
+            ),
+            "mean_kept_over_mean_correct": (
+                sum(i["kept_tokens"] / i["mean_correct_tokens"] for i in solved) / len(solved)
+                if solved
+                else 0.0
+            ),
+        }
+    consistency: dict[str, dict[str, float]] = {}
+    for n in range(1, max((i["draws"] for i in per_item), default=0) + 1):
+        group = [i for i in per_item if i["n_correct"] == n]
+        if group:
+            consistency[str(n)] = {
+                "items": len(group),
+                "mean_kept_tokens": sum(i["kept_tokens"] for i in group) / len(group),
+            }
+    solved_all = [i for i in per_item if i["n_correct"]]
+    report = {
+        "items": len(per_item),
+        "first_draw_keep_rate": sum(i["first_draw_correct"] for i in per_item) / len(per_item),
+        "at_least_one_correct_rate": len(solved_all) / len(per_item),
+        "kinds_under_50_percent": [
+            k for k, v in by_kind.items() if v["at_least_one_correct_rate"] < 0.5
+        ],
+        "mean_kept_tokens": sum(i["kept_tokens"] for i in solved_all) / len(solved_all),
+        "mean_of_all_correct_tokens": sum(i["mean_correct_tokens"] for i in solved_all)
+        / len(solved_all),
+        "kept_under_100_tokens": sum(i["kept_tokens"] < 100 for i in solved_all),
+        "by_kind": by_kind,
+        "kept_tokens_by_number_of_correct_draws": consistency,
+    }
+    return chosen, report
