+def test_training_world_shares_nothing_with_the_hard_evaluation():
+    ev, tr = hard.EVAL, hard.TRAIN
+    for group in ev.vocab():
+        left = {w.casefold() for w in ev.vocab()[group]}
+        right = {w.casefold() for w in tr.vocab()[group]}
+        assert not left & right, group
+    assert not {w.casefold() for g in ev.vocab().values() for w in g} & {
+        w.casefold() for g in tr.vocab().values() for w in g
+    }
+    for key in ev.templates:
+        assert not set(ev.templates[key]) & set(tr.templates[key])
+    assert not set(ev.noise) & set(tr.noise)
+    assert not set(ev.questions.values()) & set(tr.questions.values())
+    assert ev.system != tr.system
+    assert (ev.entry_label, ev.archive_head, ev.question_head) != (
+        tr.entry_label,
+        tr.archive_head,
+        tr.question_head,
+    )
+    eval_items = [hard.make_item(i, SEED, level) for level in (1, 2, 3) for i in range(60)]
+    train_items = [hard.make_item(i, 11, level, tr) for level in (1, 2, 3) for i in range(60)]
+    people = {
+        key: {f["entity"] for item in items for f in item["facts"]}
+        for key, items in (("eval", eval_items), ("train", train_items))
+    }
+    assert not people["eval"] & people["train"]
+    values = {
+        key: {f["value"] for item in items for f in item["facts"]}
+        for key, items in (("eval", eval_items), ("train", train_items))
