+def test_training_flavor_has_its_own_independent_oracle_agreement(level):
+    items = train_rows(level, 120)
+    assert Counter(item["kind"] for item in items) == dict.fromkeys(hard.KINDS, 20)
+    for item in items:
+        assert item["flavor"] == "train2"
